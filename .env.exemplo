# Copie para .env (que nao vai para o git) ou exporte no terminal. A senha nunca vai para o repositorio.
# Oracle da FIAP, com a conta do seu RM:
PARALLAX_DSN=oracle.fiap.com.br:1521/ORCL
PARALLAX_USER=RM000000
PARALLAX_PASSWORD=<a senha da sua conta Oracle da FIAP>
# Senha dos usuarios de demonstracao (gestor, tecnico1, produtor...). Sem ela, o setup sorteia uma.
PARALLAX_DEMO_PASSWORD=<escolha uma>
